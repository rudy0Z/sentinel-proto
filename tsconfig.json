{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "removeComments": false,
    "newLine": "lf",
    "outDir": "."
  },
  "files": [
    "terrainEngine.ts",
    "scenarioFixtures.ts",
    "scenarioPlayer.ts",
    "talon.ts",
    "commandConsole.ts"
  ]
}